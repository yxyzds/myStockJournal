DATABASE_URL=postgresql://mystockjournal:mystockjournal@localhost:5432/mystockjournal
API_PORT=3001
# Production hosts (Railway, etc.) inject PORT; the API prefers PORT there and API_PORT locally.
# Optional. Next rewrites /api/* here. Local default is http://localhost:3001
# API_ORIGIN=http://localhost:3001

# SEC EDGAR requires a contact address; requests without one get blocked.
SEC_USER_AGENT=mystockjournal dev@localhost

# Clerk — required in production. Local `pnpm dev` can omit these and use .env.development DEV_USER_*.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AI relay (中转站) — Chat Completions via fetch, no OpenAI SDK
# AI_BASE_URL=https://your-proxy.example/v1
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5
# Optional: AI_JSON_MODE=1  (only if your relay supports response_format)
