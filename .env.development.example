# Local-only overrides. Copy to `.env.development` (gitignored).
# `pnpm start` and production do not load this file.

# Used only when Clerk keys are unset. Ignored in production.
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=dev@localhost
DEV_USER_NAME=Dev

# Local outbound proxy for SEC / Yahoo. Leave blank if you can reach them directly.
# HTTPS_PROXY=http://127.0.0.1:6268
# HTTP_PROXY=http://127.0.0.1:6268
# NO_PROXY=localhost,127.0.0.1
